# Digital Architect Universal Apache / cPanel Configuration
DirectoryIndex index.html
ErrorDocument 404 /404.html

# 1. Trailing slash and clean routing for Next.js static directories
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect non-trailing-slash directories to trailing slash smoothly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# 2. Gzip Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 3. HTTP Response Headers: Security & Caching
<IfModule mod_headers.c>
  # Essential Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # 30-day cache for immutable media, styles, and scripts
  <FilesMatch "\.(ico|jpe?g|png|gif|swf|css|gz|js|webp|pdf)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # ZERO cache for HTML so content updates appear immediately on mobile & desktop
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
